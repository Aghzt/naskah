# === Konfigurasi Sumopod / DeepSeek (OpenAI-compatible) ===
# Salin file ini jadi ".env" lalu isi nilainya. JANGAN commit file .env asli.

# Base URL Sumopod (sesuai dashboard; TANPA /v1)
OPENAI_BASE_URL=https://ai.sumopod.com

# API key dari Sumopod
OPENAI_API_KEY=sk-isi-key-mu-di-sini

# Model DeepSeek di Sumopod
OPENAI_MODEL=deepseek-v4-pro

# === Pembayaran: Midtrans ===
# Ambil dari dashboard.sandbox.midtrans.com -> Settings -> Access Keys
# Untuk uji pakai kunci sandbox (SB-Mid-...). Set MIDTRANS_PRODUCTION=true saat live.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
MIDTRANS_PRODUCTION=false

# Harga: per halaman (Rupiah) dengan minimum
PRICE_PER_PAGE=500
PRICE_MIN=3000
