# === Konfigurasi Sumopod / DeepSeek (OpenAI-compatible) ===
# Salin file ini jadi ".env" lalu isi nilainya. JANGAN commit file .env asli.

# Base URL Sumopod (sesuai dashboard; TANPA /v1)
OPENAI_BASE_URL=https://ai.sumopod.com

# API key dari Sumopod
OPENAI_API_KEY=sk-isi-key-mu-di-sini

# Model DeepSeek di Sumopod
OPENAI_MODEL=deepseek-v4-pro
